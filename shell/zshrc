export NVM_DIR="$HOME/.nvm"

# Homebrew-installed nvm (macOS) checked first since it's what the rest of
# this file's original comments assumed; falls back to $NVM_DIR/nvm.sh, the
# location nvm's own official install script uses everywhere else, Linux
# included -- without this fallback, npm/node/claude (and anything installed
# via npm -g, like the Claude Code CLI) are unreachable in every login shell
# on any machine that installed nvm the standard way instead of via Homebrew.
if [ -s "/opt/homebrew/opt/nvm/nvm.sh" ]; then
    . "/opt/homebrew/opt/nvm/nvm.sh"
elif [ -s "/usr/local/opt/nvm/nvm.sh" ]; then
    . "/usr/local/opt/nvm/nvm.sh"
elif [ -s "$NVM_DIR/nvm.sh" ]; then
    . "$NVM_DIR/nvm.sh"
fi

if [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ]; then
    . "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
elif [ -s "/usr/local/opt/nvm/etc/bash_completion.d/nvm" ]; then
    . "/usr/local/opt/nvm/etc/bash_completion.d/nvm"
elif [ -s "$NVM_DIR/bash_completion" ]; then
    . "$NVM_DIR/bash_completion"
fi

HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

setopt appendhistory
setopt histignorealldups
setopt sharehistory
setopt autocd
setopt interactivecomments

mkdir -p "$HOME/.cache/zsh"

autoload -Uz compinit
compinit -d "$HOME/.cache/zsh/zcompdump"

autoload -Uz colors && colors

PROMPT='%F{green}%n@%m%f:%F{blue}%~%f %# '

alias ll='ls -lah'
alias la='ls -A'
alias ..='cd ..'
alias ...='cd ../..'
alias grep='grep --color=auto'
alias reload='source ~/.zshrc'

if command -v eza >/dev/null 2>&1; then
    alias ls='eza --group-directories-first'
    alias tree='eza --tree'
fi

if command -v bat >/dev/null 2>&1; then
    alias cat='bat --paging=never'
fi

mkcd() {
    mkdir -p -- "$1" && cd -- "$1"
}

if [ -f "$HOME/.zshrc.local" ]; then
    . "$HOME/.zshrc.local"
fi

if [[ -o interactive ]] && [[ -z "${TMUX:-}" ]] && [[ "${TERM_PROGRAM:-}" == "Apple_Terminal" ]] && [[ "${COPILOT_TMUX_AUTO_START:-0}" == "1" ]] && command -v copilot-tmux-start >/dev/null 2>&1; then
    exec copilot-tmux-start
fi
