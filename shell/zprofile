if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

export DOTFILES="$HOME/dotfiles"
export PATH="$DOTFILES/bin:$HOME/.local/bin:$HOME/bin:$PATH"

if [[ -o login && -o interactive && -x "$DOTFILES/bin/updatedot" ]]; then
    _updatedot_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
    _updatedot_stamp="$_updatedot_state_dir/updatedot-last-run"
    _updatedot_today="$(date +%Y-%m-%d)"
    _run_updatedot=1

    mkdir -p "$_updatedot_state_dir"

    if [ -f "$_updatedot_stamp" ]; then
        IFS= read -r _updatedot_last_run < "$_updatedot_stamp" || _updatedot_last_run=""
        if [ "$_updatedot_last_run" = "$_updatedot_today" ]; then
            _run_updatedot=0
        fi
    fi

    _updatedot_output=""
    if [ "$_run_updatedot" -eq 1 ]; then
        # --install-new-ssh-keys walks through any newly-added host aliases
        # one at a time, prompting for that host's password before moving to
        # the next. Piping through tee (rather than only capturing into a
        # variable) streams every line -- including the context right before
        # each password prompt -- to the terminal live, instead of silently
        # buffering it all until the whole run finishes.
        # updatedot itself now also ensures the Claude Code CLI is
        # installed/logged in, and syncs ckdCreations-claude-skills, so
        # neither needs a separate call here.
        _updatedot_output="$($DOTFILES/bin/updatedot --install-new-ssh-keys 2>&1 | tee /dev/tty || true)"
        printf '%s\n' "$_updatedot_today" > "$_updatedot_stamp"
    fi

    case "$_updatedot_output" in
        *"Dotfiles updated from "*)
            printf 'Dotfiles changed. [r]eload now, open [n]ew terminal window, or [s]kip? [r/n/s]: '
            IFS= read -r _updatedot_choice
            case "$_updatedot_choice" in
                r|R)
                    # shellcheck disable=SC1090
                    . "$HOME/.zshrc"
                    ;;
                n|N)
                    if command -v osascript >/dev/null 2>&1; then
                        if [ "${TERM_PROGRAM:-}" = "Apple_Terminal" ]; then
                            osascript -e 'tell application "Terminal" to do script ""' >/dev/null 2>&1 || true
                        elif [ "${TERM_PROGRAM:-}" = "iTerm.app" ]; then
                            osascript -e 'tell application "iTerm" to create window with default profile' >/dev/null 2>&1 || true
                        else
                            printf 'Could not auto-open a new window for this terminal app.\n'
                        fi
                    else
                        printf 'osascript is not available; cannot open a new terminal window automatically.\n'
                    fi
                    ;;
                *)
                    ;;
            esac
            ;;
        *)
            ;;
    esac
fi