#!/bin/sh

set -eu

if [ "$#" -lt 4 ] || [ "$#" -gt 5 ]; then
    printf 'Usage: %s <print|local|mesh> <local_host> <mesh_host> <port> [gateway_port]\n' "$0" >&2
    exit 2
fi

MODE=$1
LOCAL_HOST=$2
MESH_HOST=$3
PORT=$4
GATEWAY_PORT=${5:-22}
SSH_PROBE_TIMEOUT=${SSH_PROBE_TIMEOUT:-3}
PING_REQUIRE=${SSH_SELECT_REQUIRE_PING:-1}
PING_FALLBACK=${SSH_SELECT_PING_FALLBACK:-1}
PING_COUNT=${SSH_SELECT_PING_COUNT:-1}

case "$(uname -s)" in
    Darwin)
        # macOS ping -W is milliseconds.
        PING_WAIT=${SSH_SELECT_PING_WAIT:-500}
        ;;
    *)
        # Most non-macOS ping -W values are seconds.
        PING_WAIT=${SSH_SELECT_PING_WAIT:-1}
        ;;
esac

# Probe results are cached briefly. Every ssh invocation to a Match-gated
# alias runs this script, and clients like VS Code Remote-SSH open several
# connections (plus retries) within seconds. OpenSSH 10's PerSourcePenalties
# (on by default) temporarily blocks a source IP that opens connections
# without authenticating -- which is exactly what the ssh-keyscan / no-auth
# fallback probes below do -- so re-probing on every connection gets this
# machine's IP dropped by the very host it's trying to reach.
PROBE_CACHE_TTL=${SSH_SELECT_CACHE_TTL:-30}
PROBE_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/ssh-select-host"

cached_result() {
    cache_file="$PROBE_CACHE_DIR/$1"
    [ -f "$cache_file" ] || return 2
    cached_at='' cached_rc=''
    read -r cached_at cached_rc < "$cache_file" 2>/dev/null || return 2
    # Treat anything other than "<epoch> <0|1>" as a cache miss rather than
    # feeding it to shell arithmetic, which aborts the script under set -u.
    case "$cached_at" in ''|*[!0-9]*) return 2 ;; esac
    case "$cached_rc" in 0|1) ;; *) return 2 ;; esac
    [ $(( $(date +%s) - cached_at )) -lt "$PROBE_CACHE_TTL" ] || return 2
    return "$cached_rc"
}

store_result() {
    mkdir -p "$PROBE_CACHE_DIR" 2>/dev/null || return 0
    tmp_file="$PROBE_CACHE_DIR/.$1.$$"
    if printf '%s %s\n' "$(date +%s)" "$2" > "$tmp_file" 2>/dev/null; then
        mv -f "$tmp_file" "$PROBE_CACHE_DIR/$1" 2>/dev/null || rm -f "$tmp_file"
    fi
}

is_ssh_reachable() {
    host_name=$1
    probe_port=${2:-$PORT}
    cache_key="${host_name}_${probe_port}"

    [ -n "$host_name" ] || return 1

    rc=0
    cached_result "$cache_key" || rc=$?
    if [ "$rc" -ne 2 ]; then
        return "$rc"
    fi

    rc=0
    probe_host "$host_name" "$probe_port" || rc=$?
    store_result "$cache_key" "$rc"
    return "$rc"
}

probe_host() {
    host_name=$1
    probe_port=$2
    probe_output=''

    printf 'Checking %s... ' "$host_name" >&2

    # Ping first. A reply is enough to call the host reachable -- don't go on
    # to touch sshd at all (see the PerSourcePenalties note above).
    # With SSH_SELECT_PING_FALLBACK=1 (default), a ping miss still tries SSH probes.
    if [ "$PING_REQUIRE" = "1" ]; then
        if ping -n -c "$PING_COUNT" -W "$PING_WAIT" "$host_name" >/dev/null 2>&1; then
            printf 'reachable (ping)\n' >&2
            return 0
        fi
        if [ "$PING_FALLBACK" != "1" ]; then
            printf 'unreachable (no ping)\n' >&2
            return 1
        fi
        printf 'no ping, probing ssh... ' >&2
    fi

    # Fast-path: keyscan works when the host exposes SSH host keys normally.
    if ssh-keyscan -T "$SSH_PROBE_TIMEOUT" -p "$probe_port" "$host_name" >/dev/null 2>&1; then
        printf 'reachable (ssh-keyscan)\n' >&2
        return 0
    fi

    # Some hosts deny keyscan but are still reachable over SSH.
    # Treat explicit auth-denied responses as reachable for host selection.
    probe_output=$(ssh \
        -o BatchMode=yes \
        -o NumberOfPasswordPrompts=0 \
        -o PubkeyAuthentication=no \
        -o PreferredAuthentications=none,password,keyboard-interactive \
        -o ConnectTimeout="$SSH_PROBE_TIMEOUT" \
        -o StrictHostKeyChecking=accept-new \
        -p "$probe_port" \
        "$host_name" \
        exit 2>&1 || true)

    case "$probe_output" in
        *"Permission denied"*|*"Authentication failed"*)
            printf 'reachable (ssh-auth-denied)\n' >&2
            return 0
            ;;
    esac

    printf 'unreachable (no ssh)\n' >&2
    return 1
}

resolve_host() {
    printf 'Checking local network...\n' >&2
    if is_ssh_reachable "$LOCAL_HOST"; then
        printf '%s\n' "$LOCAL_HOST"
        return 0
    fi

    printf 'Checking mesh network...\n' >&2
    if is_ssh_reachable "$MESH_HOST" "$GATEWAY_PORT"; then
        printf '%s\n' "$MESH_HOST"
        return 0
    fi

    printf 'No reachable hosts found.\n' >&2
    return 1
}

case "$MODE" in
    print)
        resolve_host
        ;;
    local)
        is_ssh_reachable "$LOCAL_HOST"
        ;;
    mesh)
        ! is_ssh_reachable "$LOCAL_HOST" && is_ssh_reachable "$MESH_HOST" "$GATEWAY_PORT"
        ;;
    *)
        printf 'Unsupported mode: %s\n' "$MODE" >&2
        exit 2
        ;;
esac
