# Shared SSH aliases tracked in dotfiles.
#
# Machine-specific additions belong in ~/.ssh/config.local, which is included at
# the end of this file and intentionally stays outside git.

# Server: ckdCreations MSI Laptop (Mingus)
Host Mingus
    HostName 192.168.1.227
    User ckdcreations
    Port 22
    IdentityFile ~/.ssh/id_ed25519_Mingus
    IdentitiesOnly yes
    HostKeyAlias Mingus

Match originalhost Mingus exec "sh ~/dotfiles/bin/ssh-select-host mesh 192.168.1.227 home-mesh-jump 22"
    ProxyJump home-mesh-jump

