# Server: Forgejo Git SSH (port 2222; port 22 on this box is regular shell SSH)
# Note: id_ed25519_forgejo.pub must be registered in the Forgejo web UI under
#       your account Settings → SSH Keys (Forgejo manages its own auth database).
Host forgejo
    HostName 192.168.1.199
    User git
    Port 2222
    IdentityFile ~/.ssh/id_ed25519_forgejo
    IdentitiesOnly yes
    HostKeyAlias forgejo

Match originalhost forgejo exec "sh ~/dotfiles/bin/ssh-select-host mesh 192.168.1.199 home-mesh-jump 2222"
    ProxyJump home-mesh-jump

