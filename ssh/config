# Server: ckdCreations Mac Mini
Host ckdMacMini
    User ckdcreations
    Port 22
    IdentityFile ~/.ssh/id_ed25519_ckdMacMini
    IdentitiesOnly yes
    HostKeyAlias ckdMacMini

Match originalhost ckdMacMini exec "sh ~/dotfiles/bin/ssh-select-host local 192.168.1.226 100.97.179.166 22"
    HostName 192.168.1.226

Match originalhost ckdMacMini exec "sh ~/dotfiles/bin/ssh-select-host mesh 192.168.1.226 100.97.179.166 22"
    HostName 100.97.179.166

# Neither the LAN IP nor its own Tailscale IP is reachable directly (e.g. this
# client has no Tailscale peering to it) — fall back to routing via the jump,
# which sits on the same LAN and can always reach the LAN IP.
Match originalhost ckdMacMini exec "sh ~/dotfiles/bin/ssh-select-host none 192.168.1.226 100.97.179.166 22"
    HostName 192.168.1.226
    ProxyJump home-mesh-jump

